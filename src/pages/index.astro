---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, stack, projects, experience } from '../data/site';
import { casos } from '../data/casos';
import '../styles/features.css';
import '../styles/casos.css';

const title = `${site.name}, ${site.role}`;

const termData = {
  name: site.name,
  role: site.role,
  email: site.email,
  linkedin: site.linkedin,
  github: site.github,
  cv: site.cv,
  location: site.location,
  stack,
  projects: projects.map((p) => ({ title: p.title, live: p.live, code: p.code ?? null })),
  experience: experience
    .filter((e) => e.kind === 'work')
    .map((e) => ({ role: e.role, company: e.company, start: e.start, end: e.end })),
};
const shortcuts = ['ayuda', 'sobre', 'stack', 'proyectos', 'experiencia', 'contacto', 'cv'];
---

<Base title={title} description={site.description}>
  <SiteHeader />

  <main id="contenido">
    <!-- Hero -->
    <section class="hero" id="inicio">
      <div class="wrap hero__grid">
        <div>
          <div class="boot" aria-hidden="true">
            <span class="boot__line" data-boot>iniciar perfil --stack fullstack</span>
            <span class="boot__line" data-boot>cargar 9+ años de experiencia ... listo</span>
            <span class="boot__line" data-boot>conectar agentes, MCP y APIs de LLM ... en línea</span>
          </div>

          <h1>
            <span class="glitch" data-text="Román">Román</span>
            <span class="glitch" data-text="Madrigal">Madrigal</span>
          </h1>
          <p class="hero__role">{site.role}</p>
          <p class="hero__lead">
            Construyo aplicaciones web de punta a punta, del diseño de la interfaz a la base de datos y el
            despliegue, con IA integrada en mi forma de trabajar.
          </p>

          <div class="hero__actions">
            <a class="btn btn--primary" href="#proyectos">Ver proyectos</a>
            <a class="btn" href={site.cv} download>Descargar CV</a>
            <a class="btn" href="#contacto">Escribirme</a>
          </div>
        </div>

        <div class="portrait">
          <div class="portrait__frame">
            <div class="portrait__body">
              <div class="portrait__mark" aria-hidden="true">RM</div>
              <!-- Coloca tu foto en public/foto.jpg. Si no existe, se muestra el monograma. -->
              <img
                src="/foto.jpg"
                alt="Retrato de Román Madrigal"
                width="800"
                height="1000"
                loading="eager"
                onerror="this.remove()"
              />
              <div class="portrait__caption">
                <span class="pulse" aria-hidden="true"></span>
                <span>Disponible para trabajo remoto o reubicación en México</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sobre mí -->
    <section class="section" id="sobre-mi">
      <div class="wrap">
        <div class="section__head"><h2>Sobre mí</h2></div>
        <div class="about">
          <div class="about__text">
            <p>
              Soy <strong>desarrollador Full Stack con más de 9 años de experiencia</strong>. He construido
              sistemas web completos para empresas privadas y para el gobierno, con Angular, React, Node.js y
              Laravel como herramientas de todos los días.
            </p>
            <p>
              Desde <strong>Moriah Studio</strong> diseño y desarrollo sitios y sistemas para negocios. Y en el
              día a día trabajo con Claude Code, GitHub Copilot y ChatGPT para prototipar, revisar y entregar más
              rápido, sin soltar el criterio técnico.
            </p>
          </div>

          <dl class="facts">
            <div>
              <dt>Base</dt>
              <dd>Villahermosa, Tabasco</dd>
            </div>
            <div>
              <dt>Experiencia</dt>
              <dd>9+ años</dd>
            </div>
            <div>
              <dt>Formación</dt>
              <dd>Ingeniería en Sistemas Computacionales</dd>
            </div>
            <div>
              <dt>Modalidad</dt>
              <dd>Remoto o reubicación en México</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Proyectos -->
    <section class="section" id="proyectos">
      <div class="wrap">
        <div class="section__head"><h2>Proyectos</h2></div>
        <div class="projects">
          {
            projects.map((p) => (
              <article class:list={['card', { 'card--featured': p.featured }]} style={`--accent:${p.accent}`}>
                <div class="card__frame">
                  <div class="card__body">
                    <div class="card__bar" aria-hidden="true">
                      <span class="card__dots">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span>{p.host}</span>
                    </div>
                    <div class="card__main">
                    <figure class="card__media">
                      <span class="card__mark" aria-hidden="true">{p.mark}</span>
                      <img
                        src={`/proyectos/${p.slug}.jpg`}
                        alt={`Captura de ${p.title}`}
                        width="1280"
                        height="800"
                        loading="lazy"
                        decoding="async"
                        onerror="this.remove()"
                      />
                    </figure>
                    <div class="card__content">
                      <h3>{p.title}</h3>
                      {p.note && <span class="card__note">{p.note}</span>}
                      <p>{p.desc}</p>
                      <ul class="tags">
                        {p.tags.map((tag) => (
                          <li class="tag">{tag}</li>
                        ))}
                      </ul>
                      <div class="card__links">
                        <a class="btn btn--small" href={p.live} target="_blank" rel="noopener noreferrer">
                          Ver demo<span class="sr-only"> de {p.title}</span>
                        </a>
                        {p.code && (
                          <a
                            class="btn btn--small btn--ghost"
                            href={p.code}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            Ver código<span class="sr-only"> de {p.title}</span>
                          </a>
                        )}
                      </div>
                    </div>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Casos de estudio -->
    <section class="section" id="casos">
      <div class="wrap">
        <div class="section__head"><h2>Casos de estudio</h2></div>
        <p class="lead">Dos proyectos explicados con las decisiones detrás: qué problema había, qué elegí y por qué.</p>
        <div class="cases">
          {
            casos.map((c) => (
              <article class="case-card" style={`--accent:${c.accent}`}>
                <p class="case-card__meta">
                  {c.kind} · {c.status}
                </p>
                <h3>{c.cardTitle}</h3>
                <p>{c.summary}</p>
                <ul class="tags">
                  {c.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
                <a class="btn btn--small" href={`/casos/${c.slug}/`}>
                  Leer el caso<span class="sr-only"> de {c.cardTitle}</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Trayectoria -->
    <section class="section" id="trayectoria">
      <div class="wrap">
        <div class="section__head"><h2>Trayectoria</h2></div>
        <ol class="timeline" role="list">
          {
            experience.map((e) => (
              <li class="tl-item">
                <p class="tl-when">
                  <span>{e.start} –</span>
                  <span>{e.end}</span>
                </p>
                <div class="tl-body">
                  <h3 class="tl-role">{e.role}</h3>
                  <p class="tl-company">{e.company}</p>
                  <span class="tl-tag">{e.tag}</span>
                  {e.points.length > 0 && (
                    <ul class="tl-points">
                      {e.points.map((pt) => (
                        <li>{pt}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- IA -->
    <section class="section" id="ia">
      <div class="wrap">
        <div class="section__head"><h2>Desarrollo con IA</h2></div>
        <div class="ai-grid">
          <div class="ai-item">
            <h3>Herramientas diarias</h3>
            <p>
              Claude Code, GitHub Copilot y ChatGPT forman parte de mi flujo para prototipar, depurar y
              revisar código.
            </p>
          </div>
          <div class="ai-item">
            <h3>Agentes y MCP</h3>
            <p>
              Orquesto agentes y conecto herramientas externas con el Model Context Protocol para automatizar
              tareas de varios pasos.
            </p>
          </div>
          <div class="ai-item">
            <h3>APIs de LLM</h3>
            <p>Integro modelos de lenguaje en aplicaciones web, desde el backend hasta la interfaz.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section" id="stack">
      <div class="wrap">
        <div class="section__head"><h2>Stack</h2></div>
        <div class="stack-grid">
          {
            stack.map((group) => (
              <div class="stack-group">
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Estudio -->
    <section class="section" id="estudio">
      <div class="wrap">
        <div class="studio">
          <div class="studio__frame">
            <div class="studio__body">
              <div>
                <h2>Moriah Studio</h2>
                <p>
                  Mi estudio para negocios que quieren crecer con tecnología. Diseño sitios que se ven bien,
                  cargan rápido y llevan al cliente a contactarte.
                </p>
                <a class="btn btn--primary" href={site.studio} target="_blank" rel="noopener noreferrer">
                  Visitar Moriah Studio
                </a>
              </div>
              <ul class="services">
                <li>
                  <strong>Diseño web</strong>
                  <span>Sitios y landings a la medida de tu marca.</span>
                </li>
                <li>
                  <strong>Automatización</strong>
                  <span>Procesos que dejan de depender de tareas manuales.</span>
                </li>
                <li>
                  <strong>Desarrollo a la medida</strong>
                  <span>Sistemas y aplicaciones web para lo que tu negocio necesita.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Terminal -->
    <section class="section" id="terminal">
      <div class="wrap">
        <div class="section__head"><h2>Terminal</h2></div>
        <p class="lead">Escribe un comando o toca un atajo para explorar mi perfil.</p>

        <div class="term" data-term>
          <div class="term__frame">
            <div class="term__body">
              <div class="term__bar" aria-hidden="true">
                <span class="card__dots">
                  <i />
                  <i />
                  <i />
                </span>
                <span>roman@portafolio:~</span>
              </div>
              <div
                class="term__screen"
                role="log"
                aria-live="polite"
                aria-label="Salida de la terminal"
                tabindex="0"
                data-term-out
              >
              </div>
              <form class="term__form" data-term-form autocomplete="off">
                <span class="term__prompt" aria-hidden="true"><span class="term__host">roman@portafolio:~</span>$</span>
                <input
                  class="term__input"
                  id="term-input"
                  name="comando"
                  type="text"
                  aria-label="Escribe un comando"
                  autocomplete="off"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  enterkeyhint="send"
                />
              </form>
            </div>
          </div>
        </div>

        <div class="term__chips" role="group" aria-label="Atajos de comandos">
          {shortcuts.map((c) => (
            <button class="chip-btn" type="button" data-cmd={c}>{c}</button>
          ))}
        </div>

        <noscript>
          <p class="lead">Activa JavaScript para usar la terminal. Mientras tanto, escríbeme a {site.email}.</p>
        </noscript>
        <script id="term-data" type="application/json" is:inline set:html={JSON.stringify(termData)} />
      </div>
    </section>

    <!-- Contacto -->
    <section class="section" id="contacto">
      <div class="wrap contact">
        <div>
          <h2>¿Tienes un proyecto o una vacante?</h2>
          <p class="lead">
            Cuéntame qué necesitas. Respondo por correo y también puedes escribirme por LinkedIn.
          </p>
          <div class="contact__actions">
            <a class="btn btn--primary" href={`mailto:${site.email}`}>Escribirme por correo</a>
            <a class="btn" href={site.cv} download>Descargar CV</a>
          </div>
        </div>

        <div>
          <ul class="links">
            <li>
              <div>
                <small>Correo</small>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </div>
              <button class="btn btn--small" type="button" data-copy={site.email}>Copiar</button>
            </li>
            <li>
              <div>
                <small>LinkedIn</small>
                <a href={site.linkedin} target="_blank" rel="noopener noreferrer">roman-madrigal</a>
              </div>
            </li>
            <li>
              <div>
                <small>GitHub</small>
                <a href={site.github} target="_blank" rel="noopener noreferrer">roman08</a>
              </div>
            </li>
          </ul>
          <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <script>
    import '../scripts/terminal';
  </script>
</Base>
